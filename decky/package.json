{
  "name": "inkterface-decky",
  "version": "1.0.0-beta.2",
  "description": "Inkterface Decky Loader plugin: drives an EE05 e-paper panel over USB",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FliesWithWind/inkterface.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-machine",
    "e-ink",
    "e-paper"
  ],
  "author": "FliesWithWind",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/FliesWithWind/inkterface/issues"
  },
  "homepage": "https://github.com/FliesWithWind/inkterface#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "31.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
